# =============================================================================
# Salt Republic — production environment variables
# =============================================================================
# Copy this file to .env locally, or add the same keys in your deployment
# provider's Environment Variables / Secrets dashboard. Never commit real keys.

# Required — PostgreSQL
# Use your managed provider's *pooled* SSL connection string in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Vercel / Neon integrations sometimes provide this key instead; the app accepts it.
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_POOL_MAX=3

# =============================================================================
# Booking enquiry email — Gmail option (recommended for this setup)
# =============================================================================
# 1. Sign in to saltrepublic.mv@gmail.com
# 2. Google Account → Security → turn on 2-Step Verification
# 3. Security → App passwords → create an app password named "Salt Republic"
# 4. Paste the generated 16-character password below (spaces are accepted).
GMAIL_USER=saltrepublic.mv@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="Salt Republic <saltrepublic.mv@gmail.com>"

# Where consumer booking enquiries are sent
BOOKING_NOTIFICATION_EMAIL=saltrepublic.mv@gmail.com

# Where Travel Agent / B2B partnership enquiries are sent
B2B_NOTIFICATION_EMAIL=saltrepublic@donad.mv

# =============================================================================
# Dashboard administrator access (recommended, especially on Vercel)
# =============================================================================
# Guarantees /login works even when the users table is empty, and repairs a
# forgotten password on the next sign-in. Also used by scripts/create-admin.mjs.
# ADMIN_EMAIL=admin@saltrepublic.mv
# ADMIN_PASSWORD=choose-a-strong-password

# =============================================================================
# Google Sheets — Apps Script webhook (recommended)
# =============================================================================
# Deploy the provided Apps Script as a Web App. Paste its URL ending /exec here.
# Full setup steps: docs/ENVIRONMENT_SETUP.md
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# =============================================================================
# Optional email alternatives (use one provider only)
# =============================================================================
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Salt Republic <bookings@yourdomain.com>"
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_FROM="Salt Republic <bookings@your-verified-domain.com>"

# =============================================================================
# Optional Google Sheets service-account alternative
# =============================================================================
# GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GOOGLE_SHEETS_CLIENT_EMAIL=salt-republic@project.iam.gserviceaccount.com
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SHEET_NAME=Bookings
